# Jewelar LIVE Profit Tracker — copy to .env.local (local) and add the same keys in Railway.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM key for TikTok tokens:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Public URL of the app (OAuth redirect + webhook URL shown in the app)
APP_URL=https://live.jewelar.co

# Shared secret for the scheduler calling /api/cron/sync:  openssl rand -hex 24
CRON_SECRET=
# Apify token for Creator Opportunities follower lookups (console.apify.com/settings/integrations)
APIFY_TOKEN=

# TikTok Shop Partner Center → your app
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# the seller authorization link for your app
TIKTOK_AUTHORIZE_URL=
# optional overrides (defaults shown)
# TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com
# TIKTOK_AUTH_BASE=https://auth.tiktok-shops.com

# dev only: lets /api/webhooks/test accept signed test orders
TEST_WEBHOOK_SECRET=
